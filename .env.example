NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public school navigation link only; not SSO. Restart/rebuild after changing.
NEXT_PUBLIC_LEARNWORLDS_SCHOOL_URL=https://learn.keystoneacademia.com

# Optional Turnstile site key. Configure the matching secret in Supabase Auth
# CAPTCHA settings, not here. Anonymous Sign-ins must be enabled for free trials.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional complete pre-seen PDF, e.g. /preseen.pdf (place the file in public/).
NEXT_PUBLIC_PRESEEN_PDF_URL=

# Server-only; required to create/delete student and tutor accounts.
# Server-only: used for controlled staff account creation, deletion, and credential updates.
SUPABASE_SERVICE_ROLE_KEY=

# Email automation is OFF until SQL, sender verification and rollout are approved.
# Brevo SMTP configured in Supabase continues to handle existing Auth resets.
# The three trial notifications + branded enrolled invitation use Brevo's API.
EMAIL_AUTOMATION_ENABLED=false
BREVO_API_KEY=
EMAIL_SENDER=info@keystoneacademia.com
EMAIL_REPLY_TO=info@keystoneacademia.com
EMAIL_STUDENT_ORIGIN=https://mocks.keystoneacademia.com
# Independent random server secrets; never use NEXT_PUBLIC_ names.
EMAIL_DISPATCH_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters; preserve across retries.
EMAIL_LINK_ENCRYPTION_KEY=
