{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "key-stone-academy-cima",
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
